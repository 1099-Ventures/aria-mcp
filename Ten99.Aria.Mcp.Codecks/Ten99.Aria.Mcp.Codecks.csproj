<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>c851dcf7-dc26-4373-a8d4-b6d200189b6a</UserSecretsId>
  </PropertyGroup>

  <!-- Packaging: a self-contained dotnet tool, runnable via `dnx`. Version/feed come from the
       pipeline (ADO #428); PackAsTool here fixes the runnable shape (ADO #430). -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>aria-codecks-mcp</ToolCommandName>
    <PackageId>Ten99.Aria.Mcp.Codecks</PackageId>
    <Description>Model Context Protocol (MCP) server for Codecks project management: cards, decks, spaces, tags, milestones, runs, journeys, comments, attachments, and dependencies. Runnable as a .NET tool (aria-codecks-mcp).</Description>
    <PackageTags>aria;mcp;model-context-protocol;codecks;project-management</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.12" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ten99.Aria.Common\Ten99.Aria.Common.csproj" />
    <ProjectReference Include="..\Ten99.Aria.Hosting.Mcp.Core\Ten99.Aria.Hosting.Mcp.Core.csproj" />
  </ItemGroup>

  <!-- Dev convenience only: copy build output to the local MCP-Servers share when it exists.
       Guarded on the destination so the build stays portable (CI/dnx/pack, boxes without the share). -->

</Project>
